{
  "name": "plant-survivors-ui",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime && node scripts/prepare-asset-manifest.mjs",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:game": "node --test tests/grounding.test.mjs tests/endless-v10.test.mjs tests/music-transport.test.mjs tests/audit-improvements.test.mjs tests/game.test.mjs tests/expedition.test.mjs tests/difficulty.test.mjs tests/expansion.test.mjs tests/visual-contract.test.mjs tests/enemy-index.test.mjs tests/performance-equivalence.test.mjs tests/audio-priority.test.mjs && node tests/campaign.mjs",
    "assets:normalize": "node scripts/normalize-atlases.mjs && node scripts/stabilize-walk.mjs && node scripts/prepare-v10-assets.mjs && node scripts/prepare-v11-assets.mjs",
    "build:release": "node scripts/build-release.mjs",
    "design:tokens": "node scripts/design-system.mjs",
    "check:design": "node scripts/design-system.mjs --check",
    "test:mobile": "node scripts/test-mobile.mjs",
    "report:mobile": "node scripts/mobile-report.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "test:performance:compare": "node scripts/compare-performance.mjs",
    "report:performance": "node scripts/performance-report.mjs",
    "assets:v10": "node scripts/prepare-v10-assets.mjs",
    "assets:v11": "node scripts/prepare-v11-assets.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5",
    "typescript": "7.0.2",
    "vite": "8.1.3",
    "wrangler": "4.128.0"
  }
}
